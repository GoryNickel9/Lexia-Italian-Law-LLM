# Turso (database del sito: utenti, chat, messaggi)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Auth.js
AUTH_SECRET=

# Hermes API Server sulla VPS. Per un profilo secondario in multiplex:
# https://hermes.example.it/p/hermes_legal_site/v1
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes_legal_site

# API read-only Hermes Legal sulla VPS. Deve essere raggiungibile dal runtime Vercel.
# Esempio: https://hermes.example.it/legal-api
LEGAL_SEARCH_URL=
LEGAL_SEARCH_API_KEY=

# Email (separate da virgole) che al login diventano amministratori
# e accedono al pannello /admin (utenti, crediti, costi, registrazioni).
ADMIN_EMAILS=nome@cognome.it
